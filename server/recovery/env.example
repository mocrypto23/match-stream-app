# OVH tf-player runtime env example
# Do not commit real secret values.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_KEY=
SITE_URL=
REVALIDATE_SECRET=

# tf-player host must stay like this (set by deploy script too):
NEXT_PUBLIC_FORCE_IFRAME_PLAYER=0
NEXT_PUBLIC_IFRAME_PLAYER_ORIGIN=

# Livekora R2 agent
LIVEKORA_R2_AGENT_BIND=127.0.0.1
LIVEKORA_R2_AGENT_PORT=3500
LIVEKORA_R2_PUBLIC_BASE_URL=https://r2.tf-player.site/live
LIVEKORA_INTERNAL_APP_ORIGIN=http://127.0.0.1:3000
LIVEKORA_R2_UPLOAD_POLL_MS=2200
LIVEKORA_R2_PLAYLIST_PUBLISH_MIN_INTERVAL_MS=2500
LIVEKORA_R2_ASSET_CONCURRENCY=6
LIVEKORA_R2_MANIFEST_FETCH_TIMEOUT_MS=15000
LIVEKORA_R2_ASSET_FETCH_TIMEOUT_MS=22000
LIVEKORA_R2_IDLE_STOP_MS=600000
LIVEKORA_R2_MAX_CONSECUTIVE_FAILURES=6
LIVEKORA_R2_REMOTE_RETENTION_MS=45000
LIVEKORA_R2_PURGE_MAX_KEYS=5000

# Frontend/backend match window
NEXT_PUBLIC_PREMATCH_OPEN_WINDOW_MINUTES=30
NEXT_PUBLIC_MATCH_DURATION_MINUTES=180
NEXT_PUBLIC_POSTMATCH_GRACE_MINUTES=15

# R2
R2_ENDPOINT=
R2_BUCKET=tf-live-hls
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
