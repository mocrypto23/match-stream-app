# OVH tf-player runtime env example
# Do not commit real secret values.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_KEY=
SITE_URL=
REVALIDATE_SECRET=

# tf-player host must stay like this (set by deploy script too):
NEXT_PUBLIC_FORCE_IFRAME_PLAYER=0
NEXT_PUBLIC_IFRAME_PLAYER_ORIGIN=
NEXT_PUBLIC_P2P_SERVERS=1,2,3,4

# Repackaging flags
REPACK_ENABLED=0
REPACK_SERVERS=1,2,3,4
REPACK_READ_PCT=0
REPACK_READ_PCT_BY_SERVER=
REPACK_FORCE_DISABLE_SERVERS=
P2P_SERVERS=1,2,3,4

# Repackager local agent
REPACK_AGENT_BIND=127.0.0.1
REPACK_AGENT_PORT=3400
REPACK_PUBLIC_BASE_URL=https://r2.tf-player.site/live
REPACK_PLAYER_ORIGIN=https://tf-player.site
REPACK_LIVE_ONLY=1
REPACK_PREMATCH_OPEN_WINDOW_MINUTES=30
REPACK_MATCH_DURATION_MINUTES=180
REPACK_POSTMATCH_GRACE_MINUTES=15
REPACK_EARLY_STOP_ON_FINISHED=0
REPACK_FINISHED_DEBOUNCE_MINUTES=5
REPACK_EARLY_STOP_SEGMENT_FAIL_STREAK=4
REPACK_SEGMENT_DURATION_SEC=1
REPACK_PLAYLIST_SIZE=5
REPACK_WORK_ROOT=/tmp/tf-repack

# Frontend match window (r2_strict player gating)
NEXT_PUBLIC_PREMATCH_OPEN_WINDOW_MINUTES=30
NEXT_PUBLIC_MATCH_DURATION_MINUTES=180
NEXT_PUBLIC_POSTMATCH_GRACE_MINUTES=15

# R2
R2_ENDPOINT=
R2_BUCKET=tf-live-hls
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
